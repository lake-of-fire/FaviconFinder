igured incorrectly.","type":"text"}]},{"inlineContent":[{"type":"text","text":"However there are plently of use cases where these drawbacks are worth it to get the largest image without"},{"type":"text","text":" "},{"type":"text","text":"having to download them all, so here we are."}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Will iterate over each "},{"type":"codeVoice","code":"FaviconURL"},{"text":" and analyse the ","type":"text"},{"code":"inferredSize","type":"codeVoice"},{"type":"text","text":", and returns"},{"text":" ","type":"text"},{"type":"text","text":"the largest one."}],"variants":[{"paths":["\/documentation\/faviconfinder\/swift\/array\/largest()-70iua"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"FaviconURL"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"title":"largest()","symbolKind":"method","externalID":"s:Sa13FaviconFinderAA0A3URLVRszlE7largestACyYaKF","extendedModule":"Swift","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"largest","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"text":"throws","kind":"keyword"},{"kind":"text","text":" -> "},{"text":"FaviconURL","preciseIdentifier":"s:13FaviconFinder0A3URLV","kind":"typeIdentifier"}],"modules":[{"relatedModules":["Swift"],"name":"FaviconFinder"}],"roleHeading":"Instance Method"},"identifier":{"url":"doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Swift\/Array\/largest()-70iua","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FaviconFinder\/documentation\/FaviconFinder","doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Swift","doc:\/\/FaviconFinder\/documentation\/FaviconFinder\/Swift\/Array"